# ============================================================
#  Скопіювати в .env і заповнити. У git .env НЕ комітити.
#  chmod 600 .env
# ============================================================

# Ключ підпису сесійних кук. Згенерувати:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Куди слати нові заявки. Можна кілька адрес через кому.
ADMIN_MAIL=

# Пошта, з якої надсилаємо.
#
# Hetzner блокує вихідні порти 25 і 465, а 587 лишає відкритим —
# тому працює будь-який relay через 587.
#
# Варіант 1 (рекомендовано) — Brevo або інший сервіс розсилки:
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
#
# Варіант 2 — Gmail. Потрібен «пароль додатка» (16 символів):
# акаунт Google → Безпека → двоетапна перевірка → Паролі додатків.
# Звичайний пароль від акаунта НЕ підійде.
#   SMTP_HOST=smtp.gmail.com

# Адреса у полі «Від кого». ВАЖЛИВО: має бути підтверджений відправник
# у вашому сервісі розсилки. Технічний логін виду b5ea47001@smtp-brevo.com
# теж працюватиме, але лист батькам від такої адреси читається як спам.
MAIL_FROM=

# Адреса сайту — для посилань у листах
SITE_URL=https://children.pp.ua

# Телефони в листі батькам. Якщо не задати — беруться значення за
# замовчуванням із app.py.
PHONE_1=+380 97 382 33 79
PHONE_2=+380 95 484 01 03

# Копії бази (кнопка «Зробити копію бази» в адмінці).
# За замовчуванням лягають поруч із базою, у теці backups, і зберігаються
# останні 10 штук — старіші прибираються самі, щоб не з'їсти диск.
# Змінювати треба лише якщо копії мають лежати десь інде.
# BACKUP_DIR=/var/lib/beregynia/backups
# BACKUP_KEEP=10

# Де лежить база
DB_PATH=/var/lib/beregynia/beregynia.db
